                }
            ]
        },
        {
            "name": "mrpx Debug x64",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/main-debug.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "preLaunchTask": "make debug",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
