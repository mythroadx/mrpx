local presses = 0

def redraw()
  _clearScr(0, 0, 0)
  _drawText("Mythroad Lua guide", 8, 8, 255, 255, 255)
  _drawText("Presses: " .. _str(presses), 8, 32, 255, 255, 0)
  _dispUp(0, 0, 240, 320)
end

def dealevent(code, p0, p1)
  if code == 0 then
    presses = presses + 1
    print("GUIDE|press|" .. _str(p0) .. "|" .. _str(presses))
    redraw()
  end
  return 0
end

redraw()
print("GUIDE|ready")
